# Copy to backend/.env and fill in. Never commit the real file.

# Neon (or any Postgres with pgvector). Use the psycopg driver prefix.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: a repo URL or email sent in the User-Agent when fetching articles. Wikipedia and
# some other sites block bots that don't give one.
FETCH_CONTACT=

# For a public deployment (see "Deploy" in the README). Defaults suit running it yourself.
# SIGNUP_CODE=an-invite-code       # sign-up needs this code
# RUN_WORKER_IN_API=true           # no separate worker process
# FILE_STORE=database              # keep uploads in Postgres instead of on disk
# COOKIE_SECURE=true               # when served over https
# DAILY_QUESTIONS=300  DAILY_ITEMS=200  DAILY_QUIZZES=50

# Frontend (frontend/.env.local)
API_PROXY_TARGET=http://localhost:8000
